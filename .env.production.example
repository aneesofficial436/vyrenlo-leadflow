# Copy to .env before: docker compose -f docker/docker-compose.prod.yml up -d --build

POSTGRES_USER=leadflow
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=leadflow

ENVIRONMENT=production
EXPOSE_OPENAPI=false
LOG_LEVEL=INFO

JWT_SECRET=CHANGE_ME_LONG_RANDOM
WEBHOOK_SIGNING_SECRET=CHANGE_ME
INTERNAL_SERVICE_TOKEN=CHANGE_ME

OPENAI_API_KEY=sk-...
QUALIFICATION_DEV_HEURISTIC=false

SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=SG.xxx
SMTP_FROM=leads@yourdomain.com
SMTP_USE_TLS=true

CORS_ORIGINS=https://leadflow.yourdomain.com
NEXT_PUBLIC_API_URL=https://api.leadflow.yourdomain.com
TRUSTED_HOSTS=api.leadflow.yourdomain.com,leadflow.yourdomain.com

N8N_ENCRYPTION_KEY=CHANGE_ME
N8N_PUBLIC_URL=https://n8n.yourdomain.com/
N8N_WEBHOOK_LEAD_CREATED=https://n8n.yourdomain.com/webhook/lead-created
N8N_WEBHOOK_QUALIFICATION_COMPLETED=https://n8n.yourdomain.com/webhook/qualification-completed
N8N_ORCHESTRATES_QUALIFICATION=false