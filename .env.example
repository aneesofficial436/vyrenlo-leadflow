# --- PostgreSQL ---
POSTGRES_USER=leadflow
POSTGRES_PASSWORD=leadflow_dev_change_me
POSTGRES_DB=leadflow
DATABASE_URL=postgresql+psycopg://leadflow:leadflow_dev_change_me@localhost:5432/leadflow

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO
EXPOSE_OPENAPI=true
TRUSTED_HOSTS=
JWT_SECRET=change-me-to-a-long-random-string
JWT_ISSUER=vyrenlo-leadflow
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000

# --- Webhooks (n8n ↔ API) ---
WEBHOOK_SIGNING_SECRET=change-me-webhook-hmac-secret
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# --- OpenAI (Phase 5) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
# When OPENAI_API_KEY is unset, dev heuristic qualification (development only)
QUALIFICATION_DEV_HEURISTIC=true

# --- Email (Phase 7; Mailpit in dev) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@leadflow.local

# --- n8n (Phase 6) ---
N8N_ENCRYPTION_KEY=change-me-n8n-encryption-key
N8N_HOST=localhost
N8N_PORT=5678
# API → n8n webhook URLs (use http://n8n:5678/... when API runs in Docker)
N8N_WEBHOOK_LEAD_CREATED=http://localhost:5678/webhook/lead-created
N8N_WEBHOOK_QUALIFICATION_COMPLETED=http://localhost:5678/webhook/qualification-completed
N8N_WEBHOOK_QUALIFICATION_FAILED=http://localhost:5678/webhook/qualification-failed
N8N_ORCHESTRATES_QUALIFICATION=false

# --- Web (Phase 4) ---
NEXT_PUBLIC_API_URL=http://localhost:8000